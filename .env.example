# Supabase browser client configuration for durable HomeBoard data.
# Calendar source selection stays disabled until these values are set and migrations are run.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias still supported:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_HOMEBOARD_HOUSEHOLD_ID=

# Server-side only future placeholders. Never expose these to the browser.
# SUPABASE_SERVICE_ROLE_KEY=server-side-only-do-not-expose
# CALENDAR_ENCRYPTION_KEY=server-side-only-future

# Future integration examples:
# HOME_ASSISTANT_WEBHOOK_SECRET=
# RUNAI_API_TOKEN_SECRET=
