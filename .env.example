# Optional self-host/developer cloud override.
# Standard hosted HomeBoard uses the bundled official cloud config when these are omitted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias still supported:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_HOMEBOARD_HOUSEHOLD_ID=
# Set to true to disable the bundled official HomeBoard cloud in local development.
NEXT_PUBLIC_HOMEBOARD_DISABLE_BUILT_IN_CLOUD=

# Server-side only future placeholders. Never expose these to the browser.
# SUPABASE_SERVICE_ROLE_KEY=server-side-only-do-not-expose
# CALENDAR_ENCRYPTION_KEY=server-side-only-future

# Future integration examples:
# HOME_ASSISTANT_WEBHOOK_SECRET=
# RUNAI_API_TOKEN_SECRET=
